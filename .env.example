# Copie para .env e ajuste. Variáveis VITE_* entram no build e ficam VISÍVEIS
# no site publicado: nunca coloque segredos aqui.

# URL do Cloudflare Worker (ou de outro backend) que recebe a resposta quando
# o site está hospedado (GitHub Pages etc.). Veja worker/README.md.
# Vazio = a resposta vira um arquivo .txt baixado no aparelho de quem respondeu.
VITE_SAVE_ENDPOINT=

# Opcional: seu e-mail. Adiciona um link "enviar por e-mail" na tela final.
VITE_SEND_TO=

# Opcional: até quantos meses à frente dá para marcar (padrão: 4)
VITE_MONTHS_AHEAD=4
